{
  "name": "@q1-digital/eval-harness",
  "version": "0.1.0",
  "description": "LLM evaluation framework with statistical significance testing, regression detection, and Pareto cost-quality analysis",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "eval-harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm-evaluation",
    "benchmarking",
    "llm-as-judge",
    "regression-detection",
    "statistical-significance",
    "bootstrap",
    "pareto-analysis",
    "llmops",
    "typescript"
  ],
  "author": "Marcio Krefta <q1digitalfreela@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.0",
    "pino": "^9.1.0",
    "p-limit": "^5.0.0",
    "commander": "^12.0.0",
    "openai": "^4.52.0",
    "@anthropic-ai/sdk": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.10.0",
    "eslint": "^9.3.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
